			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[// Depot: Albrook Mall
depot.jumpTo(8.97435, -79.55264);

// The 9 stops: name, latitude, longitude
add_stops("Plaza de la Independencia",   8.95246, -79.53472);
add_stops("Hospital del Nino",           8.96877, -79.53215);
add_stops("Parque Urraca",               8.97536, -79.52730);
add_stops("USMA",                        9.02892, -79.52136);
add_stops("Los Andes Mall",              9.05208, -79.50827);
add_stops("Parque Costa del Este",       9.01483, -79.48012);
add_stops("Estadio Rommel Fernandez",    9.03586, -79.46950);
add_stops("Centro de Salud de Pedregal", 9.07022, -79.42422);
add_stops("Aeropuerto de Tocumen",       9.06909, -79.38301);

// Generation 0: POP_SIZE trucks with random routes
for (int i = 0; i < POP_SIZE; i++) {
    Truck t = add_trucks();
    t.route = randomRoute();
}
startGeneration();]]></StartupCode>
