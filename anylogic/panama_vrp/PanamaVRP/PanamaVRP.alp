					<Code><![CDATA[40]]></Code>
					<Unit Class="SpeedUnits"><![CDATA[KPH]]></Unit>
				</VelocityCode>
				<OnArrival><![CDATA[nextIndex++;
if (nextIndex < route.size()) {
    moveTo(main.stops.get(route.get(nextIndex)));   // go to the next stop
} else if (nextIndex == route.size()) {
    moveTo(main.depot);                              // all stops done: go home
} else {
    fitness = time() - startTime;
    main.truckFinished();          // tell Main I'm home
}]]></OnArrival>
