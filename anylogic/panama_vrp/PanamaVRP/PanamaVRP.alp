					<Body><![CDATA[ArrayList<Integer> r = new ArrayList<>();
for (int i = 0; i < stops.size(); i++) {
    r.add(i);
}
Collections.shuffle(r, getDefaultRandomGenerator());
return r;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Truck]]></ReturnType>
					<Id>1793212072935</Id>
					<Name><![CDATA[tournament]]></Name>
					<X>530</X><Y>670</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Truck winner = null;
for (int i = 0; i < TOURNAMENT_K; i++) {
    Truck contestant = trucks.random();
    if (winner == null || contestant.fitness < winner.fitness) {
        winner = contestant;
    }
}
return winner;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<Integer>]]></ReturnType>
					<Id>1793212076963</Id>
					<Name><![CDATA[orderedCrossover]]></Name>
					<X>530</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[a]]></Name>
						<Type><![CDATA[ArrayList<Integer>]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[b]]></Name>
						<Type><![CDATA[ArrayList<Integer>]]></Type>
					</Parameter>
					<Body><![CDATA[int n = a.size();
int start = uniform_discr(0, n - 1);          // slice starts here
int end = uniform_discr(start + 1, n);        // and stops just before here

// Step 1: copy the slice from parent A
Integer[] child = new Integer[n];             // n empty spots (null = empty)
for (int i = start; i < end; i++) {
    child[i] = a.get(i);
}

// Step 2: parent B's stops, in B's order, skipping the ones already in
List<Integer> taken = a.subList(start, end);
ArrayList<Integer> fill = new ArrayList<>();
for (int stop : b) {
    if (!taken.contains(stop)) {
        fill.add(stop);
    }
}

// Fill the empty spots left to right
int k = 0;
for (int i = 0; i < n; i++) {
    if (child[i] == null) {
        child[i] = fill.get(k);
        k++;
    }
}
return new ArrayList<>(Arrays.asList(child));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<Integer>]]></ReturnType>
					<Id>1793212079870</Id>
					<Name><![CDATA[swapMutation]]></Name>
					<X>530</X><Y>730</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[route]]></Name>
						<Type><![CDATA[ArrayList<Integer>]]></Type>
					</Parameter>
					<Body><![CDATA[ArrayList<Integer> r = new ArrayList<>(route);   // copy, like route[:]
int i = uniform_discr(0, r.size() - 1);
int j = uniform_discr(0, r.size() - 1);
while (j == i) {
    j = uniform_discr(0, r.size() - 1);          // make sure they're different
}
Collections.swap(r, i, j);
return r;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793212373562</Id>
					<Name><![CDATA[startGeneration]]></Name>
					<X>530</X><Y>760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trucksHome = 0;
for (Truck t : trucks) {
	t.startTrip();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793212416762</Id>
					<Name><![CDATA[truckFinished]]></Name>
					<X>530</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[trucksHome++;
if (trucksHome == trucks.size()) {
	nextGeneration(); // time to evolve, everyone's home
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1793212460846</Id>
					<Name><![CDATA[nextGeneration]]></Name>
					<X>530</X><Y>830</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// --- 1. Look at the results of this generation ---
List<Truck> ranked = sortAscending(trucks, t -> t.fitness);   // fastest first
Truck best = ranked.get(0);
double avg = average(trucks, t -> t.fitness);
currentAvg = avg;

if (best.fitness < bestFitness) {
    bestFitness = best.fitness;
    bestRoute = new ArrayList<>(best.route);
}
traceln("Generation " + generation + ":  best = " + best.fitness
        + " min   average = " + avg + " min");

// --- Update the dashboard ---
fitnessPlot.updateData();
txtBest.setText(String.format("%.1f min", bestFitness));
txtGen.setText(generation + " / " + GENERATIONS);
txtAvg.setText(String.format("%.1f min", avg));

// --- 2. Stop if we're done ---
if (generation == GENERATIONS) {
    traceln("DONE. Best route: " + bestRoute + "  (" + bestFitness + " min)");
    finishSimulation();
    return;
}

// --- 3. Build the next generation's routes ---
ArrayList<ArrayList<Integer>> newRoutes = new ArrayList<>();

for (int i = 0; i < ELITE; i++) {                        // elitism
    newRoutes.add(new ArrayList<>(ranked.get(i).route));
}
while (newRoutes.size() < POP_SIZE) {
    Truck mom = tournament();                            // selection
    Truck dad = tournament();
    ArrayList<Integer> child = orderedCrossover(mom.route, dad.route);   // crossover
       if (randomTrue(MUTATION_RATE)) {                     // mutation
        if (randomTrue(0.5)) {
            child = swapMutation(child);
        } else {
            child = inversionMutation(child);
        }
    }
    newRoutes.add(child);
}

// --- 4. Give the new routes to the trucks and send them out ---
for (int i = 0; i < POP_SIZE; i++) {
    trucks.get(i).route = newRoutes.get(i);
}
generation++;
startGeneration();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ArrayList<Integer>]]></ReturnType>
					<Id>1793214066817</Id>
					<Name><![CDATA[inversionMutation]]></Name>
					<X>530</X><Y>870</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[route]]></Name>
						<Type><![CDATA[ArrayList<Integer>]]></Type>
					</Parameter>
					<Body><![CDATA[ArrayList<Integer> r = new ArrayList<>(route);
int i = uniform_discr(0, r.size() - 2); // start of chunk
int j = uniform_discr(i + 1, r.size() -1); // end of chunk
Collections.reverse(r.subList(i, j + 1)); // flip the chunk
return r;]]></Body>
				</Function>
			</Functions>

